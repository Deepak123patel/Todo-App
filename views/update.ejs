<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include("navbar")%>

    <div class="container">
      <h1>Update Task Page</h1>
      <form class="todo-form" action="/update/<%= result._id%>" method="post">
        <input
         value="<%= result.title%>"
          class="input"
          type="text"
          placeholder="Enter Task Title"
          name="title"
          id=""
        />

        <br /><br />
        <textarea    class="input" name="discription"  ><%= result.discription%>"</textarea>
        <br /><br />
        <button class="btn">Add Task</button>
      </form>
    </div>
  </body>
</html>
